<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DrugFreeIndia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F8FA</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Android 12+ splash API (core-splashscreen backports it to API 26). -->
    <style name="Theme.DrugFreeIndia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F6F8FA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DrugFreeIndia</item>
    </style>
</resources>
